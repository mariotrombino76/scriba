{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@scriba/core": ["./packages/core/src/index.ts"],
      "@scriba/view": ["./packages/view/src/index.ts"],
      "@scriba/i18n": ["./packages/i18n/src/index.ts"],
      "@scriba/ui": ["./packages/ui/src/index.ts"],
      "@scriba/plugin-list": ["./packages/plugins/list/src/index.ts"],
      "@scriba/plugin-blockquote": ["./packages/plugins/blockquote/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "demo/*.ts",
    "e2e/**/*.ts",
    "packages/*/src",
    "packages/*/test",
    "packages/plugins/*/src",
    "packages/plugins/*/test"
  ],
  "exclude": ["packages/vue/**"]
}
