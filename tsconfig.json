{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // @scriba-editor/react
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@scriba-editor/core": ["./packages/core/src/index.ts"],
      "@scriba-editor/view": ["./packages/view/src/index.ts"],
      "@scriba-editor/i18n": ["./packages/i18n/src/index.ts"],
      "@scriba-editor/ui": ["./packages/ui/src/index.ts"],
      "@scriba-editor/plugin-list": ["./packages/plugins/list/src/index.ts"],
      "@scriba-editor/plugin-blockquote": ["./packages/plugins/blockquote/src/index.ts"],
      "@scriba-editor/plugin-text-style": ["./packages/plugins/text-style/src/index.ts"],
      "@scriba-editor/plugin-link": ["./packages/plugins/link/src/index.ts"],
      "@scriba-editor/plugin-code-block": ["./packages/plugins/code-block/src/index.ts"],
      "@scriba-editor/plugin-paste-clean": ["./packages/plugins/paste-clean/src/index.ts"],
      "@scriba-editor/plugin-image": ["./packages/plugins/image/src/index.ts"],
      "@scriba-editor/plugin-table": ["./packages/plugins/table/src/index.ts"],
      "@scriba-editor/plugin-comments": ["./packages/plugins/comments/src/index.ts"],
      "@scriba-editor/plugin-ai": ["./packages/plugins/ai/src/index.ts"],
      "@scriba-editor/plugin-collab": ["./packages/plugins/collab/src/index.ts"],
      "@scriba-editor/collab-server": ["./packages/collab-server/src/index.ts"],
      "@scriba-editor/plugin-bubble": ["./packages/plugins/bubble/src/index.ts"],
      "@scriba-editor/plugin-slash": ["./packages/plugins/slash/src/index.ts"],
      "@scriba-editor/plugin-mention": ["./packages/plugins/mention/src/index.ts"],
      "@scriba-editor/plugin-permissions": ["./packages/plugins/permissions/src/index.ts"],
      "@scriba-editor/plugin-task": ["./packages/plugins/task/src/index.ts"],
      "@scriba-editor/plugin-callout": ["./packages/plugins/callout/src/index.ts"],
      "@scriba-editor/plugin-file": ["./packages/plugins/file/src/index.ts"],
      "@scriba-editor/vue": ["./packages/vue/src/index.ts"],
      "@scriba-editor/react": ["./packages/react/src/index.ts"],
      "@scriba-editor/plugin-markdown": ["./packages/plugins/markdown/src/index.ts"],
      "@scriba-editor/plugin-charmap": ["./packages/plugins/charmap/src/index.ts"],
      "@scriba-editor/plugin-autosave": ["./packages/plugins/autosave/src/index.ts"],
      "@scriba-editor/plugin-details": ["./packages/plugins/details/src/index.ts"],
      "@scriba-editor/plugin-math": ["./packages/plugins/math/src/index.ts"],
      "@scriba-editor/plugin-toc": ["./packages/plugins/toc/src/index.ts"],
      "@scriba-editor/plugin-merge-tags": ["./packages/plugins/merge-tags/src/index.ts"],
      "@scriba-editor/plugin-footnotes": ["./packages/plugins/footnotes/src/index.ts"],
      "@scriba-editor/plugin-format-painter": ["./packages/plugins/format-painter/src/index.ts"],
      "@scriba-editor/plugin-a11y-checker": ["./packages/plugins/a11y-checker/src/index.ts"],
      "@scriba-editor/plugin-template": ["./packages/plugins/template/src/index.ts"],
      "@scriba-editor/plugin-revisions": ["./packages/plugins/revisions/src/index.ts"],
      "@scriba-editor/plugin-save": ["./packages/plugins/save/src/index.ts"],
      "@scriba-editor/plugin-statusbar": ["./packages/plugins/statusbar/src/index.ts"],
      "@scriba-editor/plugin-embed": ["./packages/plugins/embed/src/index.ts"],
      "@scriba-editor/plugin-visual-aids": ["./packages/plugins/visual-aids/src/index.ts"],
      "@scriba-editor/plugin-datetime": ["./packages/plugins/datetime/src/index.ts"],
      "@scriba-editor/plugin-hr": ["./packages/plugins/hr/src/index.ts"],
      "@scriba-editor/plugin-help": ["./packages/plugins/help/src/index.ts"],
      "@scriba-editor/plugin-find-replace": ["./packages/plugins/find-replace/src/index.ts"],
      "@scriba-editor/plugin-source": ["./packages/plugins/source/src/index.ts"],
      "@scriba-editor/plugin-fullscreen": ["./packages/plugins/fullscreen/src/index.ts"],
      "@scriba-editor/plugin-word-count": ["./packages/plugins/word-count/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "demo/*.ts",
    "e2e/**/*.ts",
    "packages/*/src",
    "packages/*/test",
    "packages/plugins/*/src",
    "packages/plugins/*/test"
  ],
  "exclude": ["packages/vue/**"],
  // .vue modules imported by the e2e fixture and the demo (checked by vue-tsc in packages/vue)
  "files": ["packages/vue/src/shims.d.ts"]
}
