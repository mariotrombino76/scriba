{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "@scriba/core": ["./packages/core/src/index.ts"],
      "@scriba/view": ["./packages/view/src/index.ts"],
      "@scriba/i18n": ["./packages/i18n/src/index.ts"],
      "@scriba/ui": ["./packages/ui/src/index.ts"],
      "@scriba/plugin-list": ["./packages/plugins/list/src/index.ts"],
      "@scriba/plugin-blockquote": ["./packages/plugins/blockquote/src/index.ts"],
      "@scriba/plugin-text-style": ["./packages/plugins/text-style/src/index.ts"],
      "@scriba/plugin-link": ["./packages/plugins/link/src/index.ts"],
      "@scriba/plugin-code-block": ["./packages/plugins/code-block/src/index.ts"],
      "@scriba/plugin-paste-clean": ["./packages/plugins/paste-clean/src/index.ts"],
      "@scriba/plugin-image": ["./packages/plugins/image/src/index.ts"],
      "@scriba/plugin-table": ["./packages/plugins/table/src/index.ts"],
      "@scriba/plugin-markdown": ["./packages/plugins/markdown/src/index.ts"],
      "@scriba/plugin-charmap": ["./packages/plugins/charmap/src/index.ts"],
      "@scriba/plugin-find-replace": ["./packages/plugins/find-replace/src/index.ts"],
      "@scriba/plugin-source": ["./packages/plugins/source/src/index.ts"],
      "@scriba/plugin-fullscreen": ["./packages/plugins/fullscreen/src/index.ts"],
      "@scriba/plugin-word-count": ["./packages/plugins/word-count/src/index.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "demo/*.ts",
    "e2e/**/*.ts",
    "packages/*/src",
    "packages/*/test",
    "packages/plugins/*/src",
    "packages/plugins/*/test"
  ],
  "exclude": ["packages/vue/**"]
}
