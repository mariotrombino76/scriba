{
  "name": "scriba-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node ./node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit",
    "bench": "vitest bench --run",
    "test:security": "vitest run packages/core/test/security packages/sanitize-server/test",
    "audit": "pnpm audit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.4"
  }
}
