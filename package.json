{
  "name": "scriba-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "node ./node_modules/typescript7/bin/tsc -p tsconfig.json --noEmit && pnpm --filter @scriba/vue typecheck",
    "bench": "vitest bench --run",
    "test:security": "vitest run packages/core/test/security packages/sanitize-server/test packages/plugins/permissions/test packages/collab-server/test/blocks.test.ts packages/plugins/file/test/security.test.ts packages/view/test/clipboard.test.ts",
    "audit": "pnpm audit",
    "test:e2e": "playwright test",
    "demo": "vite --config demo/vite.config.ts",
    "collab": "vite build --config e2e/collab.vite.config.ts && (node e2e/.collab/server.mjs & vite --config demo/vite.config.ts)"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "eslint": "^9.39.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "lowlight": "3.3.0",
    "prettier": "^3.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "typescript7": "npm:typescript@7.0.2",
    "vite": "8.3.4",
    "vitest": "^5.0.4",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
