{
  "name": "@scriba-editor/plugin-a11y-checker",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "license": "Apache-2.0",
  "description": "Accessibility checker for the Scriba editor: finds WCAG 2.2 issues in the document and helps fix them.",
  "dependencies": {
    "@scriba-editor/core": "workspace:*",
    "@scriba-editor/i18n": "workspace:*",
    "@scriba-editor/plugin-list": "workspace:*",
    "@scriba-editor/plugin-table": "workspace:*",
    "@scriba-editor/ui": "workspace:*",
    "@scriba-editor/view": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg",
    "accessibility",
    "wcag"
  ],
  "author": "Mario Trombino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariotrombino76/scriba.git",
    "directory": "packages/plugins/a11y-checker"
  },
  "homepage": "https://github.com/mariotrombino76/scriba/tree/main/packages/plugins/a11y-checker#readme",
  "bugs": {
    "url": "https://github.com/mariotrombino76/scriba/issues"
  }
}
