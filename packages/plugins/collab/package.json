{
  "name": "@scriba/plugin-collab",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "description": "Real-time collaboration for the Scriba editor (Yjs binding, cursors, WebSocket transport).",
  "dependencies": {
    "@scriba/core": "workspace:*",
    "@scriba/i18n": "workspace:*",
    "@scriba/view": "workspace:*",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "lib0": "0.2.119",
    "@scriba/plugin-comments": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg"
  ]
}
