{
  "name": "@scriba/plugin-paste-clean",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "license": "MIT",
