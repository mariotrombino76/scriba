{
  "name": "@scriba-editor/react",
  "version": "0.1.0",
  "description": "React wrapper for the Scriba editor: <ScribaEditor value onChange> and useScriba().",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@scriba-editor/core": "workspace:*",
    "@scriba-editor/i18n": "workspace:*",
    "@scriba-editor/ui": "workspace:*",
    "@scriba-editor/view": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg"
  ],
  "author": "Mario Trombino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariotrombino76/scriba.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/mariotrombino76/scriba/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/mariotrombino76/scriba/issues"
  }
}
