{
  "name": "@scriba/react",
  "version": "0.0.0",
  "description": "React wrapper for the Scriba editor: <ScribaEditor value onChange> and useScriba().",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@scriba/core": "workspace:*",
    "@scriba/i18n": "workspace:*",
    "@scriba/ui": "workspace:*",
    "@scriba/view": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg"
  ],
  "author": "Mario Trombino"
}
