{
  "name": "@scriba-editor/browser",
  "version": "0.1.0",
  "description": "Scriba for any web page: one script (global Scriba) or one ES module, plus the CSS. No framework, no build step.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/scriba.js",
  "module": "./dist/scriba.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/scriba.iife.js",
  "jsdelivr": "./dist/scriba.iife.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/scriba.js"
    },
    "./scriba.iife.js": "./dist/scriba.iife.js",
    "./scriba.css": "./dist/scriba.css"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && vite build --mode iife && node ../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@scriba-editor/core": "workspace:*",
    "@scriba-editor/i18n": "workspace:*",
    "@scriba-editor/plugin-template": "workspace:*",
    "@scriba-editor/plugin-image": "workspace:*",
    "@scriba-editor/ui": "workspace:*",
    "@scriba-editor/view": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg"
  ],
  "author": "Mario Trombino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariotrombino76/scriba.git",
    "directory": "packages/browser"
  },
  "homepage": "https://github.com/mariotrombino76/scriba/tree/main/packages/browser#readme",
  "bugs": {
    "url": "https://github.com/mariotrombino76/scriba/issues"
  },
  "devDependencies": {
    "@scriba-editor/plugin-a11y-checker": "workspace:*",
    "@scriba-editor/plugin-blockquote": "workspace:*",
    "@scriba-editor/plugin-charmap": "workspace:*",
    "@scriba-editor/plugin-code-block": "workspace:*",
    "@scriba-editor/plugin-details": "workspace:*",
    "@scriba-editor/plugin-embed": "workspace:*",
    "@scriba-editor/plugin-find-replace": "workspace:*",
    "@scriba-editor/plugin-footnotes": "workspace:*",
    "@scriba-editor/plugin-format-painter": "workspace:*",
    "@scriba-editor/plugin-fullscreen": "workspace:*",
    "@scriba-editor/plugin-hr": "workspace:*",
    "@scriba-editor/plugin-link": "workspace:*",
    "@scriba-editor/plugin-list": "workspace:*",
    "@scriba-editor/plugin-markdown": "workspace:*",
    "@scriba-editor/plugin-paste-clean": "workspace:*",
    "@scriba-editor/plugin-source": "workspace:*",
    "@scriba-editor/plugin-table": "workspace:*",
    "@scriba-editor/plugin-text-style": "workspace:*",
    "@scriba-editor/plugin-toc": "workspace:*"
  }
}
