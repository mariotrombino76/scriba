{
  "name": "@scriba-editor/sanitize-server",
  "version": "0.1.0",
  "description": "Server-side (Node) HTML sanitization with the same schema as the Scriba editor.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@scriba-editor/core": "workspace:*",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "katex": "0.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg"
  ],
  "author": "Mario Trombino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariotrombino76/scriba.git",
    "directory": "packages/sanitize-server"
  },
  "homepage": "https://github.com/mariotrombino76/scriba/tree/main/packages/sanitize-server#readme",
  "bugs": {
    "url": "https://github.com/mariotrombino76/scriba/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
