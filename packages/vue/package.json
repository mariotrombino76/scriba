{
  "name": "@scriba/vue",
  "version": "0.0.0",
  "description": "Vue 3 wrapper for the Scriba editor: <ScribaEditor v-model> and useScriba().",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/fix-dts.mjs",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@scriba/core": "workspace:*",
    "@scriba/i18n": "workspace:*",
    "@scriba/ui": "workspace:*",
    "@scriba/view": "workspace:*"
  },
  "devDependencies": {
    "@scriba/plugin-task": "workspace:*",
    "@scriba/plugin-callout": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg"
  ],
  "author": "Mario Trombino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariotrombino76/scriba.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/mariotrombino76/scriba/tree/main/packages/vue#readme",
  "bugs": {
    "url": "https://github.com/mariotrombino76/scriba/issues"
  }
}
