{
  "name": "@scriba/collab-server",
  "version": "0.0.0",
  "description": "Collaboration server for Scriba (y-websocket compatible): authentication, permissions, limits, server-assigned identities.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "license": "MIT",
  "dependencies": {
    "@scriba/core": "workspace:*",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "@scriba/plugin-collab": "workspace:*",
    "lib0": "0.2.119",
    "@scriba/plugin-comments": "workspace:*",
    "@scriba/plugin-permissions": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2"
  }
}
