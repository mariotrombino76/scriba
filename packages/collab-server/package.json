{
  "name": "@scriba-editor/collab-server",
  "version": "0.1.0",
  "description": "Collaboration server for Scriba (y-websocket compatible): authentication, permissions, limits, server-assigned identities.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "node ../../node_modules/typescript7/bin/tsc -p tsconfig.build.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@scriba-editor/core": "workspace:*",
    "ws": "8.22.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "@scriba-editor/plugin-collab": "workspace:*",
    "lib0": "0.2.119",
    "@scriba-editor/plugin-comments": "workspace:*",
    "@scriba-editor/plugin-permissions": "workspace:*",
    "@types/ws": "8.18.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "scriba",
    "editor",
    "rich-text",
    "wysiwyg"
  ],
  "author": "Mario Trombino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariotrombino76/scriba.git",
    "directory": "packages/collab-server"
  },
  "homepage": "https://github.com/mariotrombino76/scriba/tree/main/packages/collab-server#readme",
  "bugs": {
    "url": "https://github.com/mariotrombino76/scriba/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
